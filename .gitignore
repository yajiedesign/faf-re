# Unpacked game data (extracted from C:\ProgramData\FAForever\gamedata)
gamedata/

# Session memory is machine-local; never pushed.
.memory/

# Working plans for agent sessions (Markdown + rendered HTML + their tools); machine-local.
.plans/

# Container build tooling stays local. It names private infrastructure (the
# OCI registry it pushes to and pulls from) and pins a DirectX SDK subset we
# are not redistributing, so the whole directory is kept off the repository.
# $env:FAF_DEPS_REGISTRY configures the registry without a file.
docker/
.dockerignore

# Coverage report for the reconstruction effort. Regenerated on demand by
# skills/fa-recovery-iteration/scripts/update_readme_progress.py; machine-local
# working notes, not a published artifact.
RECOVERY_STATUS.md

# Resolve-Deps.ps1 download cache for the upstream dependency archives.
.depcache/

dependencies/.downloads/
dependencies/dxsdk/

tools/tracy/

# Built tools (go build in tools/, e.g. fakegame.exe); no exe is tracked.
*.exe

# --- machine-local additions kept from my0 ---
opencode.json
# Ghidra projects for wmdiff retail-address hunting. Cannot live under .tmp/:
# Ghidra rejects any path element that starts with '.'
# ("Path element starting with '.' is not permitted"), so this has to be a
# non-dot directory that is ignored by name instead.
ghwork/
dependencies/zlib-1.2.3/**/*
dependencies/WildMagic3p8/
dependencies/WildMagic3p8/**/*
# Only the repository-root AGENTS.md is machine-local (pointers to .memory/).
# Per-directory AGENTS.md files (tools/fafdiff/, wmdiff/, ...) are harness
# operating instructions and belong in the repository.
/AGENTS.md
dependencies/ffmpeg/
# The x87 hardware reference (x87ref32.exe) is built on demand by
# tools/x87sim/hwprobe/build.py; only the sources belong in the repo.
tools/x87sim/hwprobe/build/
